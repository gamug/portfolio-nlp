# Copy this file to .env and adjust. .env is git-ignored.
# Read by news_nlp.env at connect time; cli/news_nlp_steps.py and apps/pipeline_api.py load .env
# (news_nlp.env.load_env_file()). A relative value is resolved against the current
# working directory (NOT the repo root); an absolute value is used as-is, so write
# absolute paths here. Scripts load this file through news_nlp.env.load_env_file();
# a variable already set in the shell wins. See docs/db-topology.md.

# RESULTS / serving store: result tables + a body_text-free `articles` subset.
# Unset -> defaults to <repo>/data/nlp.db.
DATABASE_URL=/workspaces/thesis/data/nlp.db

# SOURCE store: read-only, must have `articles.body_text`. Required by the
# text-reading steps (scope, cut, summary, companies, ...); not needed for
# the steps that read only the RESULTS store (snapshot, period).
SOURCE_DATABASE_URL=/workspaces/thesis/data/urls.db

# Optional: where `python -m setup` caches the Hugging Face models
# (FinBERT, SEC-BERT NER, DeBERTa-v3 zero-shot, distilbart-cnn). Defaults to
# the platform HF cache if unset.
# HF_HOME=/workspaces/thesis/models/hf

# Optional: Hugging Face access token (huggingface_hub reads HF_TOKEN
# automatically). Not needed to run the pipeline -- the four models are public --
# but a read token lifts anonymous download rate limits for `python -m setup`,
# and the write-scope token is REQUIRED by the one-shot scripts/publish_*.py
# scripts that push models/datasets to the Hub. Never commit a real token.
# HF_TOKEN=

# --- LLM-as-judge evaluation (news_nlp.eval: the blind step-7 category judge, scripts/category_judge_2026_11_15.py) ---
# Only needed to run the accuracy evaluation. An OpenAI-compatible chat
# endpoint (DeepSeek in practice) reached via Strands' OpenAIModel. See
# docs/evaluation.md.
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_URL=https://api.deepseek.com

# --- the summariser of step 2 (`--step summary`, the default; T-206) ---
# Each falls back to the LLM_* of the same name above, which the judge reads. Set SUMMARY_LLM_MODEL when the judge must be
# another model: changing LLM_MODEL alone would not touch the step, but a new SUMMARY_LLM_* value starts a new revision.
# SUMMARY_LLM_API_KEY=
# SUMMARY_LLM_MODEL=deepseek-chat
# SUMMARY_LLM_URL=https://api.deepseek.com

# Optional: where MLflow writes eval runs/metrics/artifacts. Unset -> ./mlruns
# (a local file store; view with `uv run mlflow ui`). Point it at a shared
# tracking server / synced dir so the scheduled --check-regression job can
# compare against prior runs.
# MLFLOW_TRACKING_URI=./mlruns

# --- Snapshot and period summary (PLAN D42; docs/snapshot_steps.md) ---
# Time zone of the daily 15:00 batch cut that closes each 21-day window (IANA name).
# Default: America/New_York (Wall Street). Other American options:
#   America/New_York      US Eastern (UTC-5/-4, DST)  <- default
#   America/Toronto       Canada Eastern (UTC-5/-4, DST)
#   America/Chicago       US Central (UTC-6/-5, DST)
#   America/Denver        US Mountain (UTC-7/-6, DST)
#   America/Los_Angeles   US Pacific (UTC-8/-7, DST)
#   America/Mexico_City   Mexico (UTC-6, no DST)
#   America/Bogota        Colombia (UTC-5, no DST)
#   America/Lima          Peru (UTC-5, no DST)
#   America/Panama        Panama (UTC-5, no DST)
#   America/Caracas       Venezuela (UTC-4, no DST)
#   America/Santiago      Chile (UTC-4/-3, DST)
#   America/Sao_Paulo     Brazil (UTC-3, no DST)
#   America/Argentina/Buenos_Aires   Argentina (UTC-3, no DST)
# BATCH_TIMEZONE=America/New_York

# --- The pipeline API (apps/pipeline_api.py, docs/pipeline_api.md) -------------------------------------------------------
# The service has no authentication, so a run that spends money or holds the GPU is bounded. Ceilings per request (an unreadable
# value is the default):
#   - the most calls a summary run through the API may ask for with `max_calls` (default 5000, the CLI's own allowance);
#   - the most parallel API requests of a summary run through the API (default 16).
# PIPELINE_API_MAX_CALLS=5000
# PIPELINE_API_MAX_CONCURRENCY=16
