# Copy this file to .env and adjust. .env is git-ignored.
# Read by portfolio_common.news_nlp.env at connect time; src/pipeline.py loads
# .env (every real entrypoint imports it). A relative value is resolved
# against the current working directory (NOT the repo root -- changed when the
# DB layer moved to portfolio-common); an absolute value is used as-is. See
# docs/db-topology.md.

# RESULTS / serving store: result tables + a body_text-free `articles` subset.
# Unset -> defaults to <repo>/data/nlp.db.
DATABASE_URL=D:/thesis/data/nlp.db

# SOURCE store: read-only, must have `articles.body_text`. Required by the
# text-reading pipeline stages (sentiment / NER / category / c_summary); not
# needed for serving/query endpoints or the sector_summary stage.
SOURCE_DATABASE_URL=D:/thesis/data/urls.db

# Optional: where `python -m setup` caches the Hugging Face models
# (FinBERT, SEC-BERT NER, DeBERTa-v3 zero-shot, distilbart-cnn). Defaults to
# the platform HF cache if unset.
# HF_HOME=D:/thesis/models/hf
